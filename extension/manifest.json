{
  "manifest_version": 3,
  "name": "StreakBot Cookie Export",
  "version": "1.0.0",
  "description": "Sends this Chrome profile's Reddit cookies to StreakBot on this computer when the script asks.",
  "key": "",
  "permissions": ["cookies", "tabs"],
  "host_permissions": ["*://*.reddit.com/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "StreakBot Cookie Export"
  }
}
